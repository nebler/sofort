diff --git a/kernel/src/syscalls/ioctl.rs b/kernel/src/syscalls/ioctl.rs
new file mode 100644
index 0000000..8f56e4e
--- /dev/null
+++ b/kernel/src/syscalls/ioctl.rs
@@ -0,0 +1,13 @@
+pub fn call(a: &[usize]) -> isize {
+    let fd = match a.first() {
+        Some(&fd) => fd,
+        None => return -9,
+    };
+    if fd > 2 {
+        return -9;
+    }
+    match a.get(1) {
+        Some(&0x5413) => -25,
+        _ => -38,
+    }
+}
