+fn r9_cfg() -> R9Cfg {
+    static CFG: std::sync::OnceLock<R9Cfg> = std::sync::OnceLock::new();
+    *CFG.get_or_init(|| {
+        let reset = std::env::var("JITK_R9_RESET").unwrap_or_default();
+        R9Cfg {
+            copy: reset == "copy",
