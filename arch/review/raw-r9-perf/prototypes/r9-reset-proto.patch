+fn r9_snapshot_map(s: &Snapshot) -> *const u8 {
+    // One read-only view per snapshot file (keyed by its inode).
+    use std::os::unix::fs::MetadataExt;
+    static MAP: std::sync::Mutex<Vec<(u64, u64, usize)>> = std::sync::Mutex::new(Vec::new());
+    let md = s.memory.metadata().unwrap();
+    let key = (md.dev(), md.ino());
+    let mut m = MAP.lock().unwrap();
+    if let Some(e) = m.iter().find(|e| (e.0, e.1) == key) {
+        return e.2 as *const u8;
+    }
+    let p = (|| {
+        // SAFETY: prototype; read-only shared view of the immutable snapshot file.
+        let p = unsafe {
+            libc::mmap(
+                ptr::null_mut(),
+                RAM,
+                libc::PROT_READ,
+                libc::MAP_SHARED,
+                s.memory.as_raw_fd(),
+                0,
+            )
+        };
+        assert_ne!(p as isize, -1);
+        p as usize
+    })();
+    m.push((key.0, key.1, p));
+    p as *const u8
+}
+/// AArch64 identification registers a guest cannot modify (op0=3, op1=0,
+/// CRn=0, CRm=1..7: the ID_* block; MIDR/REVIDR; CTR_EL0, CLIDR, DCZID).
+/// MPIDR is restored. KVM rejects changed ID values after first run anyway.
+pub fn r9_invariant(id: u64) -> bool {
+    if (id >> 16) & 0xffff != 0x0013 {
+        return false;
+    }
+    let enc = id & 0xffff;
+    let (op0, op1, crn, crm, op2) = (enc >> 14 & 3, enc >> 11 & 7, enc >> 7 & 15, enc >> 3 & 15, enc & 7);
+    (op0 == 3 && op1 == 0 && crn == 0 && crm >= 1)
+        || (op0 == 3 && op1 == 0 && crn == 0 && crm == 0 && (op2 == 0 || op2 == 6))
+        || (op0 == 3 && op1 == 3 && crn == 0 && crm == 0 && (op2 == 1 || op2 == 7))
+        || (op0 == 3 && op1 == 1 && crn == 0 && crm == 0 && op2 == 1)
+}
