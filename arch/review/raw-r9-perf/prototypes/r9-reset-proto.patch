+    /// R9 PROTOTYPE (not product code): restore privately CoW'd pages of one
+    /// writable extent by copying them back from the snapshot, keeping host and
+    /// stage-2 mappings. Falls back to MADV_DONTNEED above `limit` private pages.
+    fn r9_copy_restore(&self, start: usize, end: usize, limit: usize) -> bool {
+        use std::os::unix::fs::FileExt;
+        let pages = (end - start) / 4096;
+        let mut map = vec![0u8; pages * 8];
+        let va = self.ram.ptr as usize + start;
+        R9_PAGEMAP.with(|f| f.read_exact_at(&mut map, (va / 4096 * 8) as u64)).unwrap();
+        let snap = r9_snapshot_map(self.snapshot.as_ref().unwrap());
+        let mut private = Vec::new();
+        for i in 0..pages {
+            let e = u64::from_le_bytes(map[i * 8..i * 8 + 8].try_into().unwrap());
+            // present and not file/shared-anon: a private CoW copy
+            if e >> 63 & 1 == 1 && e >> 61 & 1 == 0 {
+                private.push(i);
+            }
+        }
+        if private.len() > limit {
+            R9_STATS.with(|s| s.borrow_mut().2 += 1);
+            return false;
+        }
+        let mut differing = 0;
+        if std::env::var_os("JITK_R9_PAGES").is_some() {
+            for i in &private {
+                let off = start + i * 4096;
+                // SAFETY: prototype diagnostic; both pages are in live mappings, KVM stopped.
+                let (a, b) = unsafe {
+                    (
+                        std::slice::from_raw_parts(self.ram.ptr.add(off), 4096),
+                        std::slice::from_raw_parts(snap.add(off), 4096),
+                    )
+                };
+                let changed = a.iter().zip(b).filter(|(x, y)| x != y).count();
+                let nz_now = a.iter().filter(|x| **x != 0).count();
+                let nz_snap = b.iter().filter(|x| **x != 0).count();
+                eprintln!("r9page off={off:#x} changed={changed} nonzero_now={nz_now} nonzero_snap={nz_snap}");
+                if std::env::var_os("JITK_R9_DIFFS").is_some() {
+                    // 8-byte words that differ: offset, old, new (little endian)
+                    for w in 0..512 {
+                        let o = &b[w * 8..w * 8 + 8];
+                        let n = &a[w * 8..w * 8 + 8];
+                        if o != n {
+                            eprintln!(
+                                "r9diff off={:#x} old={:#018x} new={:#018x}",
+                                off + w * 8,
+                                u64::from_le_bytes(o.try_into().unwrap()),
+                                u64::from_le_bytes(n.try_into().unwrap())
+                            );
+                        }
+                    }
+                }
+            }
+        }
