+            let off = start + i * 4096;
+            // SAFETY: prototype; both ranges are within live mappings, KVM is stopped.
+            unsafe {
+                let dst = self.ram.ptr.add(off);
+                let src = snap.add(off);
+                if libc::memcmp(dst.cast(), src.cast(), 4096) != 0 {
+                    ptr::copy_nonoverlapping(src, dst, 4096);
+                    differing += 1;
+                }
+            }
+        }
