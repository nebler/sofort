+use core::arch::asm;
+#[repr(C)]
+struct State { active:bool, ready:bool, parked:bool, phase:usize, bits:[u64;128], mmap_bytes:usize, mmap_calls:usize, brk_calls:usize, maps:usize }
+#[unsafe(link_section=".audit")]
+static mut S:State=State{active:false,ready:false,parked:false,phase:0,bits:[0;128],mmap_bytes:0,mmap_calls:0,brk_calls:0,maps:0};
+#[unsafe(link_section=".audit")]
+pub static mut FDT:usize=0;
+unsafe extern "C" {static __audit_start:u8;static __audit_end:u8;static __guard_start:u8;static __stack_top:u8;static __bss_start:u8;static __bss_end:u8;}
+pub unsafe fn exempt(pa:usize)->bool {unsafe {
+    ((&raw const __audit_start as usize)..(&raw const __audit_end as usize)).contains(&pa) ||
+    ((&raw const __guard_start as usize)..(&raw const __stack_top as usize)).contains(&pa)
+}}
+pub unsafe fn active()->bool {unsafe{S.active}}
+pub unsafe fn mark(pa:usize) {unsafe{ if S.active && (0x80000000..0x82000000).contains(&pa) {let i=(pa-0x80000000)/4096;S.bits[i/64]|=1<<(i%64);} }}
+pub unsafe fn fault(esr:u64)->bool {unsafe {
+    if !S.active || ![0x24,0x25].contains(&(esr>>26)) || esr&(1<<6)==0 || esr&0x3c!=0x0c {return false;}
+    let far:usize;asm!("mrs {v},far_el1",v=out(reg)far);
+    if let Some(pa)=crate::mmu::audit_unprotect(far) {mark(pa);true} else {false}
+}}
+unsafe fn field(name:&str,x:usize) {unsafe{crate::console::print(name);crate::console::hex(x);}}
+pub unsafe fn begin() {unsafe {
+    S.active=false;
+    crate::console::print("\x1eaudit_meta");field(" fdt=",FDT);field(" fdt_bytes=",u32::from_be((FDT as *const u32).add(1).read()) as usize);
+    field(" bss_start=",&raw const __bss_start as usize);field(" bss_end=",&raw const __bss_end as usize);
+    field(" stack_top=",&raw const __stack_top as usize);field(" audit_start=",&raw const __audit_start as usize);field(" audit_end=",&raw const __audit_end as usize);crate::console::print("\n");
+    rearm();
+}}
+unsafe fn rearm() {unsafe {S.bits=[0;128];S.mmap_bytes=0;S.mmap_calls=0;S.brk_calls=0;S.maps=0;crate::mmu::audit_arm();S.active=true;}}
+pub unsafe fn checkpoint(name:&str,again:bool) {unsafe {
+    crate::mmu::audit_disarm();
+    S.active=false;
+    // Every checkpoint itself uses console TX; those pages are separately labeled.
+    crate::console::print("\x1eaudit ");crate::console::print(name);
+    field(" phase=",S.phase);field(" mmap_bytes=",S.mmap_bytes);field(" mmap_calls=",S.mmap_calls);field(" brk_calls=",S.brk_calls);field(" maps=",S.maps);
+    let live=(crate::user::MMAP..0x1e00000).step_by(4096).filter(|&va| crate::mmu::valid(va,false)).count()*4096;
+    field(" live_mmap=",live);field(" brk=",crate::user::BRK);
+    let top=&raw const __stack_top as usize;
+    let mut low=top;
+    for a in ((&raw const __guard_start as usize)+4096..top).step_by(8) {if (a as *const u64).read_volatile()!=0xa5a5a5a5a5a5a5a5 {low=a;break;}}
+    field(" stack_highwater=",top-low);
+    crate::console::print(" pages=");
+    for i in 0..8192 {if S.bits[i/64]&(1<<(i%64))!=0 {crate::console::hex(0x80000000+i*4096);crate::console::print(",");}}
+    crate::console::print("\n");S.phase+=1;
+    if again {rearm();}
+}}
+pub unsafe fn output(b:&[u8]) {unsafe {
+    if b.windows(11).any(|x| x==b"\"t\":\"ready\"") {S.ready=true;}
+    if b.windows(10).any(|x| x==b"\"t\":\"done\"") {checkpoint("done",true);}
+}}
+pub unsafe fn syscall(n:usize,a:&[usize]) {unsafe {
+    if n==73 && S.ready && !S.parked {S.parked=true;checkpoint("ready",true);}
+    if n==93 || n==94 {checkpoint("exit",false);}
+
+    if n==214 {S.brk_calls+=1;}
+}}
+
+pub unsafe fn returned(n:usize,a:&[usize],ret:isize) {unsafe {if n==222 && ret>0 {S.mmap_calls+=1;S.mmap_bytes+=(a[1]+4095)&!4095;}}}
+pub unsafe fn mapped() {unsafe {if S.active {S.maps+=1;}}}
