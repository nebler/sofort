+use std::sync::{Mutex,atomic::{AtomicBool,AtomicU64,Ordering}};
+use std::time::Instant;
+static ORIGIN: AtomicU64=AtomicU64::new(0);
+static START: std::sync::OnceLock<Instant> = std::sync::OnceLock::new();
+static DATA: Mutex<Vec<(u32,u128,i64,i64,i64,i64)>> = Mutex::new(Vec::new());
+static EXITS: [AtomicU64;80] = [const {AtomicU64::new(0)};80];
+static SNAP:Mutex<Vec<(u32,Vec<u64>)>>=Mutex::new(Vec::new());
+static FIRST: AtomicBool = AtomicBool::new(true);
+static ENABLED: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+pub fn enabled()->bool{true}
+pub fn mark(id:u32){if !enabled(){return;}if id==0 {unsafe extern "C" {fn mach_absolute_time()->u64;}ORIGIN.store(unsafe{mach_absolute_time()}*125/3,Ordering::Relaxed);} let ns=START.get_or_init(Instant::now).elapsed().as_nanos();
+ let mut u:libc::rusage=unsafe{std::mem::zeroed()};unsafe{libc::getrusage(libc::RUSAGE_SELF,&mut u);}
+ DATA.lock().unwrap().push((id,ns,u.ru_utime.tv_sec*1000000+u.ru_utime.tv_usec as i64,u.ru_stime.tv_sec*1000000+u.ru_stime.tv_usec as i64,u.ru_nvcsw as i64,u.ru_nivcsw as i64));}
+pub fn enter(){if enabled()&&FIRST.swap(false,Ordering::Relaxed){mark(40);}}
+pub fn exit(reason:u32,syndrome:u64){if !enabled(){return;} let i=if reason==1{(syndrome>>26) as usize}else{64+reason as usize};if i<80{EXITS[i].fetch_add(1,Ordering::Relaxed);}}
+pub fn dump(){if !enabled(){return;}mark(99);eprintln!("A2_ORIGIN {}",ORIGIN.load(Ordering::Relaxed));for (id,ns,u,s,v,iv) in DATA.lock().unwrap().iter(){eprintln!("A2 {{\"id\":{id},\"ns\":{ns},\"user_us\":{u},\"sys_us\":{s},\"nvcsw\":{v},\"nivcsw\":{iv}}}");}let a:Vec<_>=EXITS.iter().map(|x|x.load(Ordering::Relaxed)).collect();eprintln!("A2_EXITS {:?}",a);for (id,c) in SNAP.lock().unwrap().iter(){eprintln!("A2_AT {id} {:?}",c);}}
+
+pub fn wire(b:&[u8],input:bool){if !enabled(){return;}let id=if input {if b.starts_with(b"{\"t\":\"run\""){51}else if b.starts_with(b"{\"t\":\"ret\""){54}else{0}}else{if b.starts_with(b"{\"t\":\"ready\""){50}else if b.starts_with(b"{\"t\":\"done\""){52}else if b.starts_with(b"{\"t\":\"call\""){53}else{0}};if id!=0{mark(id);SNAP.lock().unwrap().push((id,EXITS.iter().map(|x|x.load(Ordering::Relaxed)).collect()));}}
