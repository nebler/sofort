+use crate::{wait,console};
+#[unsafe(no_mangle)] pub static mut A2_BOOT:u64=1;
+static mut TIMES:[u64;32]=[0;32];
+pub fn mark(i:usize){unsafe{TIMES[i]=wait::ticks();}}
+pub fn dump(){unsafe{TIMES[0]=A2_BOOT;let mut b=[b' ';550];b[..5].copy_from_slice(b"\x1eA2G ");let mut n=5;for t in TIMES {for i in 0..16{b[n+i]=b"0123456789abcdef"[((t>>((15-i)*4))&15)as usize];}n+=17;}b[n]=10;console::record(&b[..n+1]);}}
+pub fn probe(esr:u64,f:&mut [usize])->bool{let i=(esr&65535) as usize;if !(0x100..0x110).contains(&i){return false;} mark(i-0x100+10);unsafe{match i {
+0x100|0x102=>{let sp:usize;core::arch::asm!("mrs {},sp_el0",out(reg)sp);f[29]=sp;},
+0x101=>f[3]=f[1],0x103=>f[19]=f[0],0x104=>f[20]=f[0],0x105=>f[2]=(f[2] as i32 as isize) as usize,_=>{}}}true}
+pub unsafe fn patch(){unsafe{for (addr,op,id) in [(0x4001e4,0x910003fd,0x100),(0x40eae4,0xaa0103e3,0x101),(0x4a7ee4,0x910003fd,0x102),(0x400668,0xaa0003f3,0x103),(0x400540,0xaa0003f4,0x104),(0x4011a4,0x93407c42,0x105)]{let p=crate::mmu::physical(addr) as *mut u32;assert_eq!(*p,op);*p=0xd4000001|(id<<5);}}}
