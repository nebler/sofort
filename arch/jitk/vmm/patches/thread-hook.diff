+//! jitk: per-thread confinement hook (Firecracker-style per-role seccomp).
+//! The embedder registers one fn before build(); every libkrun thread that can
+//! touch guest-controlled state calls `enter(role)` before its first guest-driven action.
+use std::sync::OnceLock;
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Role { Vcpu, ConsoleRx, ConsoleTx }
+static HOOK: OnceLock<fn(Role)> = OnceLock::new();
+pub fn set(f: fn(Role)) -> bool { HOOK.set(f).is_ok() }
+pub fn enter(role: Role) { if let Some(f) = HOOK.get() { f(role) } }
