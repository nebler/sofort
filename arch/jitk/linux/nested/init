#!/bin/sh
mkdir -p /proc /sys /dev /tmp
mount -t proc proc /proc; mount -t sysfs sys /sys; mount -t devtmpfs dev /dev 2>/dev/null
mount -t tmpfs tmp /tmp; mkdir -p /sys/fs/cgroup; mount -t cgroup2 none /sys/fs/cgroup
ulimit -n 16384
cd /work
export JITK_BIN=/work JITK_LABEL=NESTED JITK_REPORT=/tmp/report.json
. ./env.sh
./linux-tools suite 2>&1
rc=$?
echo "JITK_EXIT=$rc"
echo o > /proc/sysrq-trigger
sleep 10
