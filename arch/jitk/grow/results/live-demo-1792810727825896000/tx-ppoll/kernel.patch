diff --git a/src/syscalls/ppoll.rs b/src/syscalls/ppoll.rs
new file mode 100644
index 0000000..e9dc19f
--- /dev/null
+++ b/src/syscalls/ppoll.rs
@@ -0,0 +1,48 @@
+use super::{copyin, copyout, writable, poll_fd, now_ns, park_poll};
+
+pub fn call(a: &[usize]) -> isize {
+    if a.len() < 5 { return -22; }
+    if a[3] != 0 { return -38; }
+    let n = a[1];
+    if n > 16 { return -22; }
+    let deadline = if a[2] == 0 {
+        None
+    } else {
+        let mut t = [0u8; 16];
+        if copyin(a[2], &mut t).is_err() { return -14; }
+        let sec = i64::from_le_bytes([t[0], t[1], t[2], t[3], t[4], t[5], t[6], t[7]]);
+        let ns = i64::from_le_bytes([t[8], t[9], t[10], t[11], t[12], t[13], t[14], t[15]]);
+        if sec < 0 || ns < 0 || ns >= 1_000_000_000 { return -22; }
+        let duration = match (sec as u64).checked_mul(1_000_000_000).and_then(|v| v.checked_add(ns as u64)) {
+            Some(v) => v,
+            None => return -22,
+        };
+        Some(now_ns().saturating_add(duration))
+    };
+    let len = n * 8;
+    let mut buf = [0u8; 128];
+    if len != 0 {
+        if a[0] == 0 || a[0].checked_add(len).is_none() { return -14; }
+        if copyin(a[0], &mut buf[..len]).is_err() || !writable(a[0], len) { return -14; }
+    }
+    loop {
+        let mut ready = 0isize;
+        let mut input = false;
+        for i in 0..n {
+            let p = i * 8;
+            let fd = i32::from_le_bytes([buf[p], buf[p + 1], buf[p + 2], buf[p + 3]]);
+            let events = i16::from_le_bytes([buf[p + 4], buf[p + 5]]);
+            let revents = if fd < 0 { 0 } else { poll_fd(fd, events) };
+            if fd == 0 { input = true; }
+            let bytes = revents.to_le_bytes();
+            buf[p + 6] = bytes[0];
+            buf[p + 7] = bytes[1];
+            if revents != 0 { ready += 1; }
+        }
+        if ready != 0 || deadline.map_or(false, |d| now_ns() >= d) {
+            if len != 0 && copyout(a[0], &buf[..len]).is_err() { return -14; }
+            return ready;
+        }
+        park_poll(deadline, input);
+    }
+}
