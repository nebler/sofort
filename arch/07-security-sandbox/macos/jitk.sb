;; jitk-vmm production Seatbelt profile (macOS). Applied IN-PROCESS by jitk-vmm via
;; sandbox_init/sandbox_apply after dyld has mapped all libraries and BEFORE
;; VmmBuilder::build() (which starts the vCPU). Therefore no dylib, exec, or
;; Mach/IOKit grants are needed: HVF calls (hv_vm_create, hv_vcpu_run) are not
;; mediated by these operations on macOS 26.6.1 (verified: boot + SYSTEM_OFF).
(version 1)
(deny default)
;; The only file: the immutable, content-addressed guest image directory (RAW load
;; happens inside build()). Read-only; no metadata/xattr/listing elsewhere.
(allow file-read-data (subpath (param "IMAGES")))
;; libkrun arch_memory_regions -> sysconf(_SC_PAGESIZE) -> this sysctl
;; (src/arch/src/aarch64/mod.rs:56 unwraps; denial = abort, verified).
(allow sysctl-read (sysctl-name "hw.pagesize_compat"))
