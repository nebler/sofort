;; Verified: macOS 26.6.1 / arm64, bare PSCI-off kernel, libkrun a1d8616.
;; /tmp resolves to /private/tmp. No broad system-library or Mach grants needed.
(version 1)
(deny default)
;; Restrict execution to these experiment binaries; production permits only jitk-vmm.
(allow process-exec
  (literal "/private/tmp/jitk-07/host")
  (literal "/private/tmp/jitk-07/probe"))
(allow file-read-data (literal "/"))
(allow file-read-data file-read-metadata
  (literal "/private/tmp/jitk-07/libkrun.2.dylib")
  (literal "/private/tmp/jitk-07/kk.bin"))
(allow sysctl-read (sysctl-name "hw.pagesize_compat"))
